{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    "outDir": "bin",
    "rootDir": ".",
    "sourceMap": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": false,
    "noEmit": false,

    "experimentalDecorators": true
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "bin"]
}