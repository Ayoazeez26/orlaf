{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "bin",
    "rootDir": ".",
    "strict": true,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "experimentalDecorators": true,
    "pretty": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true
  },
  "include": [
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "bin"
  ]
}