# Backend URL — used ONLY as the server-side proxy target (Nitro routeRules in
# vite.config.ts). The browser ALWAYS calls /api on this app's own origin, and
# the app server proxies to this URL, keeping the sable_rt_admin refresh cookie
# first-party. Must be set at build time in prod.
VITE_API_BASE_URL=http://localhost:3000
