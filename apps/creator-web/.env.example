# App
NODE_ENV=development

# Backend URL — used ONLY as the server-side proxy target (Nitro routeRules in
# vite.config.ts). The browser ALWAYS calls /api on this app's own origin, and
# the app server proxies to this URL, keeping the sable_rt_creator refresh cookie
# first-party (required for mobile Safari). Must be set at build time in prod.
VITE_API_BASE_URL=http://localhost:3000
# VITE_API_BASE_URL=https://orlaf-monorepo.onrender.com

# Google OAuth — Web client ID (must match backend GOOGLE_CLIENT_ID_WEB)
VITE_GOOGLE_CLIENT_ID=

# Tawk.to widget embed URL, from the "how to install" email (embed.tawk.to/<property>/<widget>)
VITE_TAWK_SRC=https://embed.tawk.to/6a99aa0180d7c5344788323c/1k1k405ue
