# App
NODE_ENV=development

# Backend URL — proxied in dev (browser calls /api on same origin); direct in production builds
VITE_API_BASE_URL=http://localhost:3000
# VITE_API_BASE_URL=https://orlaf-monorepo.onrender.com

# Google OAuth — Web client ID (must match backend GOOGLE_CLIENT_ID_WEB)
VITE_GOOGLE_CLIENT_ID=
