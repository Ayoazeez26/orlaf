# App
NODE_ENV=development
PORT=3000

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

GOOGLE_CLIENT_ID_MOBILE=
GOOGLE_CLIENT_ID_WEB=
APPLE_SERVICE_ID_MOBILE=
APPLE_SERVICE_ID_WEB=

# Email (Resend OTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Sable Creators <onboarding@sable.tv>"
OTP_EXPIRES_IN_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Comma-separated origins allowed for credentialed CORS (creator-web, admin-web)
ALLOWED_ORIGINS=http://localhost:3001,https://orlaf-creator-web.vercel.app

# Creator onboarding
# Base URL used to build creator invite accept links (falls back to APP_URL).
CREATOR_WEB_URL=http://localhost:3001
# When true, organic signups land in pending_approval after onboarding.
# Default false — new creators become active immediately.
CREATOR_REQUIRE_APPROVAL=false

# Super admin bootstrap (pnpm seed:superadmin)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=



SENTRY_DSN=
APP_URL=


CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_WEBHOOK_SECRET=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
