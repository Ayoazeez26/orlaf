# App
NODE_ENV=development
PORT=3000

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

GOOGLE_CLIENT_ID_MOBILE=
GOOGLE_CLIENT_ID_WEB=
APPLE_SERVICE_ID_MOBILE=
APPLE_SERVICE_ID_WEB=

# Comma-separated origins allowed for credentialed CORS (creator-web, admin-web)
ALLOWED_ORIGINS=http://localhost:3001,https://orlaf-creator-web.vercel.app